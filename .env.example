# Étape 2 : Supabase. Sans ces deux valeurs, l'application tourne en « mode démonstration »
# (exercices de démo en lecture seule, sans connexion).
# Noms acceptés pour la clé : NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY ou NEXT_PUBLIC_SUPABASE_ANON_KEY
# (ceux créés par l'intégration Vercel ↔ Supabase conviennent).
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# URL publique du site, utilisée dans les liens de connexion envoyés par e-mail.
# Facultatif en local (déduite de la requête).
NEXT_PUBLIC_SITE_URL=
# Étape 5 : Claude (clé côté serveur uniquement, jamais NEXT_PUBLIC_)
ANTHROPIC_API_KEY=
